# Vox-Lingo: Nach Änderungen die Stunde beenden und die App neu starten.
# Vorrang: System-/Prozessumgebung > diese Datei > Programmvorgaben.
# Anbieter sind unabhängig von Groß-/Kleinschreibung; kein automatischer Wechsel.

# Port des lokalen Dienstes.
KI_PORT=3212
# Eigenes Datenverzeichnis; relative Pfade beginnen im Projekt.
KI_DATA_DIR=data

# Schlüssel ausschließlich als Windows-Benutzer-/Systemumgebungsvariablen setzen.
# Schlüsselwerte in .env werden ignoriert; openai_api_key wird unterstützt.
# Hier alle Schlüssel leer lassen. Eine lokale .env niemals committen.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Live-Sprache: openai / gemini. Stimmen bestimmt der jeweilige Anbieter.
LIVE_MODEL_PROVIDER=openai
GPT_LIVE_MODEL=gpt-live-1
GPT_VOICE=marin
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore

# Unterricht: Planung, Antwortbewertung, Tafelsteuerung und Zusammenfassung.
# openai / deepseek, jeweils über den offiziellen Responses-Endpunkt.
BACKEND_MODEL_PROVIDER=openai
OPENAI_BACKEND_MODEL=gpt-6-luna
# OpenAI-Denkstufen hängen vom Modell ab, z. B. none / low / medium / high.
OPENAI_BACKEND_REASONING_EFFORT=low
# auto / fast: als service_tier übergeben; fast erfordert Modell-/Kontozugriff
# und kann zusätzliche Kosten verursachen.
OPENAI_BACKEND_SERVICE_TIER=fast
DEEPSEEK_BACKEND_MODEL=deepseek-flash
# DeepSeek: none / low / high / max; none deaktiviert das Denken.
DEEPSEEK_BACKEND_REASONING_EFFORT=low

# Spracheingabe bei der Vorbereitung: openai / gemini.
# Live-Untertitel stammen weiterhin vom gewählten Live-Anbieter.
TRANSCRIPTION_MODEL_PROVIDER=openai
GPT_TRANSCRIPTION_MODEL=gpt-transcribe
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Gespräche und Unterrichtspläne: Vorbereitung, Themenpflege und Planerstellung.
# openai / gemini / deepseek, unabhängig vom Unterrichts-Backend.
TEACHER_MODEL_PROVIDER=openai
OPENAI_TEACHER_MODEL=gpt-6-luna
OPENAI_TEACHER_THINKING_LEVEL=high
# OpenAI-Vorbereitung verwendet fest auto; diese Variable wird ignoriert.
OPENAI_TEACHER_SERVICE_TIER=auto
# Gemini verwendet natives generateContent und Werkzeugaufrufe, keine Responses-Parameter.
GEMINI_TEACHER_MODEL=gemini-3.5-flash-lite
# Gemini: minimal / low / medium / high, abhängig vom Modell.
GEMINI_TEACHER_THINKING_LEVEL=high
DEEPSEEK_TEACHER_MODEL=deepseek-flash
DEEPSEEK_TEACHER_THINKING_LEVEL=high
